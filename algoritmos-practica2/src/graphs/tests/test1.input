# ================================================================
# Test 1: Grafo NON DIRIXIDO con alcance fixo moderado (8.000 km)
# ================================================================

# 1. Cargar o grafo non dirixido con radio fixo de 8.000 km
LOAD data.json 8000

# 2. Comprobar a matriz de adxacencia
PRINT

# 3. Percorridos BFS (WIDTH) e DFS (DEPTH) dende a ISS
TRAVEL ISS WIDTH
TRAVEL ISS DEPTH

# 4. Validar xestión de erros para un nodo non existente
TRAVEL SateliteInexistente WIDTH

# 5. Identificar as compoñentes conexas (1 principal LEO + 8 nodos illados)
COMPONENTS

# 6. Atopar puntos de articulación (Identifica Hubble como punto crítico)
FIND_CUT_VERTICES

# 7. Ruta óptima Dijkstra con relés intermediarios (ISS -> Hubble -> Sentinel-2A)
PATH ISS Sentinel-2A

# 8. Ruta cara a un satélite illado (James Webb sen camiño posible)
PATH ISS "James Webb"